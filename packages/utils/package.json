{
  "name": "@deweyou-design/utils",
  "version": "0.3.3",
  "description": "Framework-agnostic runtime utilities for Deweyou Design consumers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deweyou/design.git"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "directory": "dist"
  },
  "scripts": {
    "build": "vp pack && node ../infra/scripts/write-published-manifest.mjs .",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
