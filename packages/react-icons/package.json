{
  "name": "@deweyou-design/react-icons",
  "version": "0.0.6",
  "description": "React icon components for Deweyou UI generated from curated TDesign SVG sources.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "directory": "dist"
  },
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && vp pack && node ../infra/scripts/write-published-manifest.mjs .",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-dom": "catalog:",
    "tdesign-icons-svg": "0.4.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
